# ==========================================
# EXPENSE TRACKER - ENVIRONMENT CONFIGURATION
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option A: Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker

# Option B: MongoDB Atlas (Cloud)
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/expense-tracker?retryWrites=true&w=majority

# Frontend API URL (Used by React client in development/production)
VITE_API_BASE_URL=http://localhost:5000/api
